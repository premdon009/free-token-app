# GENERATED by scripts/gen_router.py from providers.yml. Do not edit by hand.
# Copy to router/.env, fill in what you have, then: chmod 600 router/.env
# One account per provider, used within its terms. An empty key just skips that provider.
# Never commit router/.env.

# Any long random string; clients (Claude Code, apps) send it as their API key.
# Make one with: python3 -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=

# Groq (in router) · key: https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio (Gemini API) (in router) · key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cerebras Inference (in router) · key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# OpenRouter (:free models) (in router) · key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Mistral (Free mode) (in router) · key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Z.ai (GLM Flash models) (in router) · key: https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# NVIDIA NIM (build.nvidia.com) (in router) · key: https://build.nvidia.com
NVIDIA_API_KEY=

# Cloudflare Workers AI (in router) · key: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1

# Cohere (trial keys) (in router) · key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Requesty (free plan) (not in the default chain) · key: https://app.requesty.ai/sign-up
REQUESTY_API_KEY=

# LLM7.io (not in the default chain) · key: https://dash.llm7.io
LLM7_API_KEY=

# Sarvam AI (not in the default chain) · key: https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Ollama Cloud (not in the default chain) · key: https://ollama.com/settings/keys
OLLAMA_CLOUD_API_KEY=

# Ollama (local) (in router) · key: https://ollama.com/download
OLLAMA_API_BASE=http://127.0.0.1:11434

