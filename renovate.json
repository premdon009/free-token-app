{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["pep621", "github-actions", "docker-compose", "npm"],
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "packageRules": [
    {
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["ghcr.io/berriai/litellm"],
      "versioning": "regex:^(main-)?v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-stable)?$",
      "pinDigests": true,
      "automerge": false,
      "labels": ["security-review"],
      "prBodyNotes": [
        "LiteLLM had malicious releases in 2026. Before merging: check https://github.com/BerriAI/litellm/security for this version, and that it's at least 7 days old. For a high/critical advisory fix, run scripts/pin_image.py litellm instead: it allows a fixed release from 24 hours old."
      ]
    },
    {
      "matchPackageNames": ["ghcr.io/berriai/litellm"],
      "allowedVersions": "!/^(main-)?v1\\.(82\\.[78]|107\\.0)(-stable)?$/"
    },
    {
      "matchManagers": ["github-actions", "pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor updates"
    }
  ]
}
