{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "free-token": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Free Token router (local)",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "free/coding": {
          "name": "free/coding"
        },
        "free/fast": {
          "name": "free/fast"
        },
        "free/private": {
          "name": "free/private"
        },
        "local": {
          "name": "local"
        }
      }
    }
  },
  "model": "free-token/free/coding",
  "small_model": "free-token/free/fast"
}
